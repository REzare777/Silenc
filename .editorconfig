# Настройки редактора кода
# Применяется ко всем файлам проекта: Visual Studio Code, VS 2022, WebStorm, Sublime.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.html]
indent_size = 2

[*.{js,mjs,cjs,ts}]
indent_size = 2

# Сборочные скрипты и конфиги — без отступов
[Makefile]
indent_style = tab
